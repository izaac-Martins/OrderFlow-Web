<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0E6"
    tools:context=".MainActivityPedido">

    <!-- 1. Header Bordô Profundo (#46141A / Gradiente Vertical) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="164dp"
        android:background="@drawable/bg_header_gradient"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Esquerda: Título "Cheiro\nde Café" em 2 linhas + Subtítulo "Cardápio Digital" -->
        <LinearLayout
            android:id="@+id/containerMarcaHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/containerPilulasDireitaHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/txtTituloMarcaHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="0.9"
                android:text="Cheiro&#10;de Café"
                android:textColor="#F7F2EB"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtituloMarcaHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cardápio Digital"
                android:textColor="#D7C4BE"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Direita: 2 Pílulas Empilhadas Verticalmente -->
        <LinearLayout
            android:id="@+id/containerPilulasDireitaHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Pílula Superior: Avatar 32dp + Bolinha Verde 8dp + Texto "Garçom" + Menu 3 Pontos -->
            <LinearLayout
                android:id="@+id/pilulaPerfilGarcom"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_header_outline_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingEnd="4dp">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgPerfilFuncionario"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="#46161C"
                        android:contentDescription="Avatar do Garçom"
                        android:scaleType="centerCrop"
                        android:src="@drawable/cheirodecafe"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.CheiroCafe.Circle"
                        app:strokeColor="#55FFFFFF"
                        app:strokeWidth="1dp" />

                    <View
                        android:id="@+id/indicadorOnlineGarcom"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_online_dot" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtNomeGarcomHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Garçom"
                    android:textColor="#F7F2EB"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnMenuOpcoes"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menu de Opções"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_more_vert_modern" />
            </LinearLayout>

            <!-- Pílula Inferior: Ícone Cadeado Branco + "Monitor KDS" -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMonitorPedidosHeader"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_header_outline_pill"
                android:drawableStart="@drawable/ic_lock_small"
                android:drawablePadding="6dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:stateListAnimator="@null"
                android:text="Monitor KDS"
                android:textAllCaps="false"
                android:textColor="#F7F2EB"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. Barra de Busca Flutuante (52dp, bg_search_bar.xml, elevation 6dp) -->
    <EditText
        android:id="@+id/editTextSearch"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="-26dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_search_bar"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="10dp"
        android:drawableTint="#6E6259"
        android:elevation="6dp"
        android:hint="Buscar café, doce ou salgado..."
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="@color/text_primary"
        android:textColorHint="#6E6259"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerContainer" />

    <!-- 3. Abas Principais em Formato Pílula (42dp altura, 24dp radius) -->
    <LinearLayout
        android:id="@+id/linearLayoutButtons"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextSearch">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonDoces"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_unselected"
            android:stateListAnimator="@null"
            android:text="Doces"
            android:textAllCaps="false"
            android:textColor="#46161C"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonSalgados"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_unselected"
            android:stateListAnimator="@null"
            android:text="Salgados"
            android:textAllCaps="false"
            android:textColor="#46161C"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonBebidas"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_selected"
            android:stateListAnimator="@null"
            android:text="Bebidas"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3.1. Chips Dinâmicos de Subcategoria (Exibidos quando houver subcategorias) -->
    <HorizontalScrollView
        android:id="@+id/scrollSubcategorias"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutButtons"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/containerChipsSubcategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Título da Seção Ativa -->
    <TextView
        android:id="@+id/textViewLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="22dp"
        android:text="Bebidas &amp; Cafés"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrollSubcategorias" />

    <!-- 4. Grade Simétrica Permanente de 2 Colunas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProdutos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="14dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/painelCarrinhoIFood"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewLabel"
        app:spanCount="2"
        tools:listitem="@layout/item_produto" />

    <!-- 5. Barra Inferior da Comanda (bg_bottom_cart_bar.xml, 32dp radius, #281511) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/painelCarrinhoIFood"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bottom_cart_bar"
        android:elevation="10dp"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/containerTexto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnVerSacola"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/txtTotalItensPainel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comanda • 0 itens"
                android:textColor="#D7C4BE"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPrecoTotalPainel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="R$ 0,00"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerSacola"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="Ver Sacola"
            android:textAllCaps="false"
            android:textColor="#46161C"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#F3EDE2"
            app:cornerRadius="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
