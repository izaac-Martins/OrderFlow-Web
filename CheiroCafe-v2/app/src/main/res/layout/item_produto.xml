<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="#EAE0D5"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Imagem com cantos arredondados de 14dp via ShapeableImageView -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProduto"
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:contentDescription="Imagem do produto"
            android:scaleType="centerCrop"
            android:src="@drawable/cafeprensa"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.CheiroCafe.Corner14" />

        <!-- Badge de Categoria / Subcategoria (#EAE0D5, texto #5A3E36 10sp bold uppercase) -->
        <TextView
            android:id="@+id/tvCategoriaBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_badge_item"
            android:ellipsize="end"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:paddingStart="9dp"
            android:paddingTop="3dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3dp"
            android:text="ESPECIAL"
            android:textAllCaps="true"
            android:textColor="#5A3E36"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Nome do Produto: 14sp Bold, 2 linhas fixas para simetria horizontal na grade -->
        <TextView
            android:id="@+id/tvNomeProduto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:lineSpacingExtra="1dp"
            android:minLines="2"
            android:maxLines="2"
            android:text="Cappuccino Especial"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Resumo curto de Variantes / Opções -->
        <TextView
            android:id="@+id/tvVariantesResumo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:text="Tamanho único"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- Rodapé do Card: Preço (16sp bold #46161C) + Botão '+' circular (36dp x 36dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPrecoProduto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="2"
                android:text="R$ 12,00"
                android:textColor="#46161C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdicionarRapidoCard"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:clickable="false"
                android:focusable="false"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="#46161C"
                app:cornerRadius="18dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
