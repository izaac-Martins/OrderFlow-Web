<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootMonitorPedidos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5F2">

    <!-- Topbar -->
    <LinearLayout
        android:id="@+id/headerMonitor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#432A20"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnVoltarMonitor"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monitor de Pedidos"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtituloSincronizacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acompanhamento em tempo real (Cozinha / Salão)"
                android:textColor="#E7D7C9"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAtualizarAgora"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#FFFFFF"
            android:text="Atualizar"
            android:textAllCaps="false"
            android:textColor="#432A20"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Banner Offline-First (quando há pedidos salvos localmente aguardando Wi-Fi) -->
    <LinearLayout
        android:id="@+id/bannerOfflinePendente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FEF3C7"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/headerMonitor">

        <TextView
            android:id="@+id/txtMensagemOfflinePendente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Há itens gravados offline aguardando conexão Wi-Fi."
            android:textColor="#92400E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSincronizarOffline"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#D97706"
            android:text="Sincronizar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Barra Horizontal de Filtros dos 5 Estados Canônicos -->
    <HorizontalScrollView
        android:id="@+id/scrollFiltrosStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/bannerOfflinePendente">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFiltroTodos"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_fundo_selecionado"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Todos"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFiltroRecebido"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_fundo_cinza"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Recebidos"
                android:textAllCaps="false"
                android:textColor="#571D22"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFiltroEmPreparo"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_fundo_cinza"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Em Preparo"
                android:textAllCaps="false"
                android:textColor="#571D22"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFiltroPronto"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_fundo_cinza"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Prontos"
                android:textAllCaps="false"
                android:textColor="#571D22"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFiltroEntregue"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_fundo_cinza"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Entregues"
                android:textAllCaps="false"
                android:textColor="#571D22"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFiltroCancelado"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/btn_fundo_cinza"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Cancelados"
                android:textAllCaps="false"
                android:textColor="#571D22"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Lista Reativa de Pedidos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPedidosMonitor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollFiltrosStatus" />

    <!-- Estado Vazio -->
    <TextView
        android:id="@+id/txtMonitorVazio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:gravity="center"
        android:text="Nenhum pedido encontrado para este filtro no momento."
        android:textColor="#78716C"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollFiltrosStatus" />

</androidx.constraintlayout.widget.ConstraintLayout>
