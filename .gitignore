# ═══════════════════════════════════════════════════════════════
# OrderFlow — .gitignore raiz unificado (Backend + Master + KDS)
# ═══════════════════════════════════════════════════════════════

# ─── Java / Maven ───
**/target/
*.jar
*.war
*.class
.mvn/wrapper/maven-wrapper.jar
**/.mvn/wrapper/maven-wrapper.jar

# Banco H2 local gerado pelo perfil "local"
*.mv.db
*.trace.db

# ─── Node / React / Vite ───
**/node_modules/
**/dist/
**/dist-ssr/
*.local
*.tsbuildinfo
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── IDEs & Sistema ───
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.DS_Store
Thumbs.db
desktop.ini

# ─── Segredos & Logs ───
.env
.env.*
!.env.example
*.log
logs/
*.pem
*.key
